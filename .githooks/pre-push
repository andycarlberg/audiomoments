#!/bin/sh
set -eu

zero_sha="0000000000000000000000000000000000000000"
has_non_delete=0

while read -r _ local_sha _ _; do
	if [ -n "${local_sha:-}" ] && [ "$local_sha" != "$zero_sha" ]; then
		has_non_delete=1
		break
	fi
done

if [ "$has_non_delete" -eq 0 ]; then
	exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

make test
make lint
